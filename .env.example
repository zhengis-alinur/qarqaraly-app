# For local npm development; Compose overrides the database hostname.
MONGODB_URI=mongodb://127.0.0.1:27017/qarqaraly
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
UPLOAD_DIR=./uploads
CONFIRM_REMINDER_DAYS=30
STALE_DAYS=60
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Qarqaraly <noreply@localhost>
# Mobizon SMS: коды подтверждения для регистрации и входа по номеру телефона (https://mobizon.kz).
# Без MOBIZON_API_KEY код печатается в консоль при разработке, а в production отправка отклоняется.
MOBIZON_API_KEY=
# Согласованный буквенный отправитель; оставьте пустым, чтобы использовать имя по умолчанию в аккаунте Mobizon.
MOBIZON_SENDER=
MOBIZON_API_URL=https://api.mobizon.kz
# Отдельный ключ для подписи кодов и токенов подтверждения; пусто — используется SESSION_SECRET.
PHONE_OTP_SECRET=
# Номера для приёмки: SMS не отправляется, код фиксирован. Формат: +77010000001:123456,+77010000002:654321
PHONE_OTP_TEST_NUMBERS=

# Set true ONLY behind a trusted proxy that replaces x-forwarded-for.
TRUST_PROXY=false
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
